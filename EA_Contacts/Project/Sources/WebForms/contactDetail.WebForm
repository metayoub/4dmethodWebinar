		"styles": [
			{
				"name": "pageShell",
				"id": "clsPageShell",
				"parentId": null,
				"content": "self {\n  font-family: \"Segoe UI\", \"Helvetica Neue\", Arial, sans-serif;\n}\n@media (max-width: 720px) {\n  self .profileRow {\n    flex-direction: column !important;\n    align-items: center !important;\n    text-align: center;\n  }\n  self .addrRow {\n    flex-direction: column !important;\n  }\n}"
			},
			{
				"name": "cardSurface",
				"id": "clsCardSurface",
				"parentId": null,
				"content": "self {\n  background-color: #ffffff;\n  border: 1px solid #e5e7eb;\n  border-radius: 16px;\n  box-shadow: 0 1px 3px rgba(17,24,39,0.08), 0 1px 2px rgba(17,24,39,0.04);\n}"
			},
			{
				"name": "field",
				"id": "clsField",
				"parentId": null,
				"content": "self {\n  width: 100%;\n}\nself label {\n  display: block;\n  margin-bottom: 6px;\n}\nself label span {\n  color: #374151;\n  font-size: 13px;\n  font-weight: 600;\n}\nself input {\n  width: 100%;\n  height: 44px;\n  border: 1px solid #d1d5db;\n  border-radius: 10px;\n  padding: 0 12px;\n  background: #ffffff;\n  color: #111827;\n  font-size: 14px;\n  box-shadow: none !important;\n  transition: border-color .15s ease, box-shadow .15s ease;\n}\nself input:focus,\nself:focus-within input {\n  outline: none;\n  border-color: #2563eb;\n  box-shadow: 0 0 0 3px rgba(37,99,235,0.15) !important;\n}\nself input::placeholder {\n  color: #9ca3af;\n}"
			},
			{
				"name": "actionBtn",
				"id": "clsActionBtn",
				"parentId": null,
				"content": "self {\n  border-radius: 10px;\n  cursor: pointer;\n  transition: background-color .15s ease, box-shadow .15s ease, transform .05s ease;\n}\nself:hover {\n  box-shadow: 0 2px 8px rgba(17,24,39,0.14);\n}\nself:active {\n  transform: translateY(1px);\n}\nself:focus-visible {\n  outline: 2px solid #2563eb;\n  outline-offset: 2px;\n}"
			}
		],
